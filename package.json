{
  "name": "remotion-video-auto-editor",
  "version": "1.0.0",
  "description": "Desktop AI Video Editor powered by Remotion, Electron & Edge-TTS",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "postinstall": "npm run build",
    "dev": "vite",
    "build": "tsc && vite build && node scripts/ensure-render-entry.mjs",
    "preview": "vite preview",
    "electron:start": "electron dist-electron/main.js",
    "test": "node run-tests.mjs",
    "remotion:preview": "remotion preview src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts MainComposition out/video.mp4"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@remotion/media-utils": "^4.0.245",
    "@remotion/player": "^4.0.245",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "edge-tts-universal": "^1.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.245",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.245",
    "@remotion/cli": "^4.0.245",
    "@remotion/renderer": "^4.0.245",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
